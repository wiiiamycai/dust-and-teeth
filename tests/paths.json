      "Go",
      "Leave (map)",
      "TRAVEL:Rustwater",
      "Doc Ratchet",
      "RAND:0.99",
      "Brain Juice",
      "EXPECT:S.stats.brains === 3 && dumb()"
    ]
  },
  {
    "name": "Growth: surviving fights makes you a little tougher",
    "steps": [
      "Crawl out of bed",
      "Go",
      "EXPECT:(() => { const m = S.maxhp; survived(); return S.maxhp === m + 1 && S.c.fights === 1 })()",
      "EVAL:fight([mkE('Rat', 'R', 1)], {})",
      "FIGHT",
      "EXPECT:S.c.fights === 2"
