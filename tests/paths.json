      "WAIT:2",
      "EXPECT:S.n.moe.op >= m + 15 && S.later.length === 0"
    ]
  },
  {
    "name": "Gossip: kill Junior's mother and he hunts you on the road",
    "steps": [
      "Crawl out of bed",
      "Go",
