      "RAND:0.99",
      "EVAL:globalThis.s = S.skills.speech + S.skx.speech || S.skills.speech",
      "crashed plane",
      "EXPECT:S.skills.speech + (S.skx.speech || 0) > s"
    ]
  },
  {
