    ]
  },
  {
    "name": "Gossip: a caught lie spreads, and liars find talking harder",
    "steps": [
      "Crawl out of bed",
      "Go",
      "REAL",
      "EVAL:globalThis.c = chanceOf('nigel.move')",
      "EVAL:learn('nigel', event('lied', 'gus', { wit: [] }))",
      "EXPECT:liarTo('nigel') && chanceOf('nigel.move') <= c - 10"
    ]
  },
  {
    "name": "Growth: one fixed, average man, no presets",
    "steps": [
      "Crawl out of bed",
      "Go",
      "REAL",
      "EXPECT:S.name === 'Nobody' && Object.values(S.stats).every(v => v === 5)",
      "EXPECT:Object.values(S.skills).every(v => v >= 30 && v <= 35)"
    ]
  },
  {
    "name": "Growth: no levels, no XP bar, no skill points",
    "steps": [
      "Crawl out of bed",
      "Go",
      "EXPECT:!/Lv |XP|Level up/.test(document.getElementById('hud').innerHTML)",
      "Character",
      "EXPECT:!/skill points|PERK:|Level/.test(document.getElementById('text').innerHTML + document.getElementById('head').innerHTML + cur.map(o => o[0]).join())"
    ]
  },
  {
    "name": "Growth: skills grow by use, and slower when high",
    "steps": [
      "Crawl out of bed",
      "Go",
      "REAL",
      "EVAL:globalThis.a = S.skills.steal; for (let i = 0; i < 10; i++) practice('steal', 1.5); globalThis.lo = S.skills.steal - a",
      "EVAL:S.skills.steal = 85; S.skx.steal = 0; for (let i = 0; i < 10; i++) practice('steal', 1.5); globalThis.hi = S.skills.steal - 85",
      "EXPECT:lo >= 12 && hi >= 1 && hi <= lo / 3"
    ]
  },
  {
    "name": "Growth: you learn from failed conversations too",
    "steps": [
      "Crawl out of bed",
      "Go",
      "Climb down the well",
      "Nigel",
